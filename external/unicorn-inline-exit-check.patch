Unicorn calls a helper after every guest load and store, and at the start
of every block, to see whether an exit has been requested; that was about a
third of Bejeweled 3's loading time. The block check is now an inline test,
as in QEMU. The one after each access goes unless a hook could stop emulation
on a mapped page, and a faulting store now leaves at once, as a faulting load
already did, so it still stops at the right instruction. Targets with a delay
slot flag keep the block check as it was: the brcond ends the basic block,
and the flag is a temp that has to live across it. Applied by CMakeLists.txt
at configure time.

diff --git a/qemu/accel/tcg/cputlb.c b/qemu/accel/tcg/cputlb.c
index 5f2611e..552bfdb 100644
--- a/qemu/accel/tcg/cputlb.c
+++ b/qemu/accel/tcg/cputlb.c
@@ -2157,6 +2157,29 @@ store_memop(void *haddr, uint64_t val, MemOp op)
     }
 }
 
+/*
+ * B32_INLINE_EXIT_CHECK: leave at the faulting store, as loads do, instead of
+ * flagging an exit for a check after every memory access to act on. This is
+ * what helper_check_exit_request does.
+ */
+static void store_fault_exit(struct uc_struct *uc, uintptr_t retaddr)
+{
+    cpu_exit(uc->cpu);
+    if (uc->nested_level == 0 || uc->cpu->stopped) {
+        return;
+    }
+    if (uc->nested_level == 1) {
+        tb_exec_unlock(uc);
+    }
+    uc->cpu->tcg_exit_req = 0;
+    if (uc->skip_sync_pc_on_exit) {
+        uc->skip_sync_pc_on_exit = false;
+        cpu_loop_exit(uc->cpu);
+    } else {
+        cpu_loop_exit_restore(uc->cpu, retaddr);
+    }
+}
+
 static inline void
 store_helper(CPUArchState *env, target_ulong addr, uint64_t val,
              TCGMemOpIdx oi, uintptr_t retaddr, MemOp op)
@@ -2244,7 +2267,7 @@ store_helper(CPUArchState *env, target_ulong addr, uint64_t val,
             uc->invalid_addr = paddr;
             uc->invalid_error = UC_ERR_WRITE_UNMAPPED;
             // printf("***** Invalid memory write at " TARGET_FMT_lx "\n", addr);
-            cpu_exit(uc->cpu);
+            store_fault_exit(uc, retaddr);
             return;
         } else {
             uc->invalid_error = UC_ERR_OK;
@@ -2263,7 +2286,7 @@ store_helper(CPUArchState *env, target_ulong addr, uint64_t val,
             mr = uc->memory_mapping(uc, paddr);
             if (mr == NULL) {
                 uc->invalid_error = UC_ERR_MAP;
-                cpu_exit(uc->cpu);
+                store_fault_exit(uc, retaddr);
                 return;
             }
         }
@@ -2309,7 +2332,7 @@ store_helper(CPUArchState *env, target_ulong addr, uint64_t val,
             uc->invalid_addr = paddr;
             uc->invalid_error = UC_ERR_WRITE_PROT;
             // printf("***** Invalid memory write (ro) at " TARGET_FMT_lx "\n", addr);
-            cpu_exit(uc->cpu);
+            store_fault_exit(uc, retaddr);
             return;
         }
     }
@@ -2319,7 +2342,7 @@ store_helper(CPUArchState *env, target_ulong addr, uint64_t val,
         if (!mr) {
             uc->invalid_addr = paddr;
             uc->invalid_error = UC_ERR_NOMEM;
-            cpu_exit(uc->cpu);
+            store_fault_exit(uc, retaddr);
             return;
         }
         /* refill tlb after CoW */
diff --git a/qemu/include/exec/gen-icount.h b/qemu/include/exec/gen-icount.h
index 8b484cb..4ae489a 100644
--- a/qemu/include/exec/gen-icount.h
+++ b/qemu/include/exec/gen-icount.h
@@ -32,8 +32,28 @@ static inline void gen_io_end(TCGContext *tcg_ctx)
 
 static inline void gen_tb_start(TCGContext *tcg_ctx, TranslationBlock *tb)
 {
-    TCGv_ptr puc = tcg_const_ptr(tcg_ctx, tcg_ctx->uc);
-    TCGv_i32 tmp = tcg_const_i32(tcg_ctx, 0);
+    TCGv_ptr puc;
+    TCGv_i32 tmp;
+    TCGLabel *no_exit = NULL;
+
+    /*
+     * B32_INLINE_EXIT_CHECK: the helper is a call at the start of every
+     * block, and only does anything once an exit has been asked for. Test
+     * for that here, as QEMU does. The brcond ends the basic block, so not
+     * with a delay slot flag, a temp that has to live across it.
+     */
+    if (tcg_ctx->delay_slot_flag == NULL) {
+        TCGv_i32 count = tcg_temp_new_i32(tcg_ctx);
+        no_exit = gen_new_label(tcg_ctx);
+        tcg_gen_ld_i32(tcg_ctx, count, tcg_ctx->cpu_env,
+                       offsetof(ArchCPU, neg.icount_decr.u32) -
+                       offsetof(ArchCPU, env));
+        tcg_gen_brcondi_i32(tcg_ctx, TCG_COND_GE, count, 0, no_exit);
+        tcg_temp_free_i32(tcg_ctx, count);
+    }
+
+    puc = tcg_const_ptr(tcg_ctx, tcg_ctx->uc);
+    tmp = tcg_const_i32(tcg_ctx, 0);
     // Unicorn:
     //    We CANT'T use brcondi_i32 here or we will fail liveness analysis
     //    because it marks the end of BB
@@ -43,6 +63,9 @@ static inline void gen_tb_start(TCGContext *tcg_ctx, TranslationBlock *tb)
     gen_helper_check_exit_request(tcg_ctx, puc, tmp);
     tcg_temp_free_i32(tcg_ctx, tmp);
     tcg_temp_free_ptr(tcg_ctx, puc);
+    if (no_exit != NULL) {
+        gen_set_label(tcg_ctx, no_exit);
+    }
 }
 
 static inline void gen_tb_end(TCGContext *tcg_ctx, TranslationBlock *tb, int num_insns)
diff --git a/qemu/tcg/tcg-op.c b/qemu/tcg/tcg-op.c
index d0223ea..2edbba3 100644
--- a/qemu/tcg/tcg-op.c
+++ b/qemu/tcg/tcg-op.c
@@ -2872,6 +2872,26 @@ void check_exit_request(TCGContext *tcg_ctx)
     tcg_temp_free_ptr(tcg_ctx, puc);
 }
 
+/*
+ * B32_INLINE_EXIT_CHECK: a call after every load and store costs more than
+ * the access. Faulting accesses leave by themselves, so this is only needed
+ * for a hook that can stop emulation on a mapped page. (An unmapped-memory
+ * hook can't run for one.)
+ */
+static void check_exit_after_access(TCGContext *tcg_ctx)
+{
+    struct uc_struct *uc = tcg_ctx->uc;
+
+    if (HOOK_EXISTS(uc, UC_HOOK_MEM_READ) ||
+        HOOK_EXISTS(uc, UC_HOOK_MEM_READ_AFTER) ||
+        HOOK_EXISTS(uc, UC_HOOK_MEM_READ_PROT) ||
+        HOOK_EXISTS(uc, UC_HOOK_MEM_WRITE) ||
+        HOOK_EXISTS(uc, UC_HOOK_MEM_WRITE_PROT) ||
+        HOOK_EXISTS(uc, UC_HOOK_MEM_FETCH_PROT)) {
+        check_exit_request(tcg_ctx);
+    }
+}
+
 static void tcg_gen_req_mo(TCGContext *tcg_ctx, TCGBar type)
 {
 #ifdef TCG_GUEST_DEFAULT_MO
@@ -2917,7 +2937,7 @@ void tcg_gen_qemu_ld_i32(TCGContext *tcg_ctx, TCGv_i32 val, TCGv addr, TCGArg id
         }
     }
 
-    check_exit_request(tcg_ctx);
+    check_exit_after_access(tcg_ctx);
 }
 
