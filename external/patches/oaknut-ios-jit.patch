 namespace oaknut {
 
+// On an iOS device (not the simulator) nothing can map writable-executable
+// memory itself. A debugger (StikDebug, AltJIT, TrollStore) that set
+// CS_DEBUGGED on the process answers `brk #0xf00d` by mapping an executable
+// region for it, and the process builds a writable alias of that region with
+// vm_remap. Every request costs a debugger round trip and the region cannot
+// grow, so one region is requested for all code blocks and carved into
+// equal slots: dynarmic makes one per guest thread.
+#if defined(__APPLE__) && TARGET_OS_IPHONE && !TARGET_OS_SIMULATOR
+#    ifndef OAKNUT_JIT_POOL_SLOTS
+#        define OAKNUT_JIT_POOL_SLOTS 16
+#    endif
+
+namespace detail {
+
+// x16 = 1: x0 = address hint (null), x1 = size; the debugger returns the
+// executable region in x0.
+__attribute__((noinline, optnone, naked)) static void* prepare_jit_region(void*, std::size_t)
+{
+    __asm__ volatile(
+        "mov x16, #1\n"
+        "brk #0xf00d\n"
+        "ret\n");
+}
+
+// x16 = 0: the debugger detaches; the mappings stay valid.
+__attribute__((noinline, optnone, naked)) static void detach_jit_server()
+{
+    __asm__ volatile(
+        "mov x16, #0\n"
+        "brk #0xf00d\n"
+        "ret\n");
+}
+
+class JitPool {
+public:
+    struct Slot {
+        std::uint32_t* xmem = nullptr;
+        std::uint32_t* wmem = nullptr;
+        int index = -1;
+    };
+
+    static JitPool& instance()
+    {
+        static JitPool pool;
+        return pool;
+    }
+
+    // An empty slot (xmem == nullptr) if the debugger refused, the size
+    // differs from the first request's, or every slot is taken.
+    Slot acquire(std::size_t size)
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (m_xbase == nullptr) {
+            const std::size_t total = size * OAKNUT_JIT_POOL_SLOTS;
+            void* x = prepare_jit_region(nullptr, total);
+            if (x == nullptr || x == MAP_FAILED)
+                return {};
+
+            vm_address_t w = 0;
+            vm_prot_t cur_prot, max_prot;
+            if (vm_remap(mach_task_self(), &w, total, 0, VM_FLAGS_ANYWHERE | VM_FLAGS_RANDOM_ADDR, mach_task_self(), reinterpret_cast<mach_vm_address_t>(x), false, &cur_prot, &max_prot, VM_INHERIT_NONE) != KERN_SUCCESS)
+                return {};
+            if (vm_protect(mach_task_self(), w, total, false, VM_PROT_READ | VM_PROT_WRITE) != KERN_SUCCESS)
+                return {};
+
+            m_xbase = static_cast<std::uint8_t*>(x);
+            m_wbase = reinterpret_cast<std::uint8_t*>(w);
+            m_slot_size = size;
+            m_should_detach = true;
+        } else if (size != m_slot_size) {
+            return {};
+        }
+
+        for (int i = 0; i < OAKNUT_JIT_POOL_SLOTS; i++) {
+            if (!m_in_use[i]) {
+                m_in_use[i] = true;
+                return {reinterpret_cast<std::uint32_t*>(m_xbase + i * m_slot_size), reinterpret_cast<std::uint32_t*>(m_wbase + i * m_slot_size), i};
+            }
+        }
+        return {};
+    }
+
+    void release(int index)
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_in_use[index] = false;
+    }
+
+    // True once: the first block detaches the debugger after its prelude.
+    bool take_detach()
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        const bool detach = m_should_detach;
+        m_should_detach = false;
+        return detach;
+    }
+
+private:
+    std::mutex m_mutex;
+    std::uint8_t* m_xbase = nullptr;
+    std::uint8_t* m_wbase = nullptr;
+    std::size_t m_slot_size = 0;
+    bool m_in_use[OAKNUT_JIT_POOL_SLOTS] = {};
+    bool m_should_detach = false;
+};
+
+}  // namespace detail
+#endif
