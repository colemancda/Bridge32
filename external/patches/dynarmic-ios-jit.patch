+#if defined(__APPLE__) && TARGET_OS_IPHONE
+
+// Plain atomics: the JIT-emitted lock below needs a code block made while the
+// image loads, before a debugger can have enabled JIT on an iOS device.
+void SpinLock::Lock() {
+    while (__atomic_exchange_n(&storage, 1, __ATOMIC_ACQUIRE)) {
+        __asm__ volatile("yield");
+    }
+}
+
+void SpinLock::Unlock() {
+    __atomic_store_n(&storage, 0, __ATOMIC_RELEASE);
+}
