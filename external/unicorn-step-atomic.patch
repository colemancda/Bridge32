Unicorn stops the world for a locked instruction the host can't do atomically
(EXCP_ATOMIC: one split across a word boundary), and has nothing to do it with,
so it re-runs the instruction forever. Bridge32's guests do use them, so it
runs alone instead, compiled without CF_PARALLEL. Applied by CMakeLists.txt at
configure time.

diff --git a/qemu/accel/tcg/cpu-exec.c b/qemu/accel/tcg/cpu-exec.c
index 77168f35..9aed2841 100644
--- a/qemu/accel/tcg/cpu-exec.c
+++ b/qemu/accel/tcg/cpu-exec.c
@@ -18,6 +18,7 @@
  */
 
 #include "qemu/osdep.h"
+#include <pthread.h>
 #include "qemu-common.h"
 #include "hw/core/cpu.h"
 #include "exec/exec-all.h"
@@ -137,6 +138,27 @@ static void cpu_exec_nocache(CPUState *cpu, int max_cycles,
     tcg_tb_remove(cpu->uc->tcg_ctx, tb);
 }
 
+/* B32_STEP_ATOMIC: a locked instruction the host can't do atomically (split
+   across a word boundary) runs alone, as plain loads and stores, one at a time
+   across the process. Without this EXCP_ATOMIC just retries forever. */
+static void b32_step_atomic(CPUState *cpu)
+{
+    static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+    CPUArchState *env = cpu->env_ptr;
+    TranslationBlock *tb;
+    target_ulong pc, cs_base;
+    uint32_t flags;
+
+    cpu_get_tb_cpu_state(env, &pc, &cs_base, &flags);
+    pthread_mutex_lock(&lock);
+    tb = tb_gen_code(cpu, pc, cs_base, flags, CF_NOCACHE | 1);
+    tb->orig_tb = NULL;
+    cpu_tb_exec(cpu, tb);
+    tb_phys_invalidate(cpu->uc->tcg_ctx, tb, -1);
+    tcg_tb_remove(cpu->uc->tcg_ctx, tb);
+    pthread_mutex_unlock(&lock);
+}
+
 struct tb_desc {
     target_ulong pc;
     target_ulong cs_base;
@@ -369,6 +391,12 @@ static inline bool cpu_handle_exception(CPUState *cpu, int *ret)
         return false;
     }
 
+    if (cpu->exception_index == EXCP_ATOMIC) {
+        cpu->exception_index = -1;
+        b32_step_atomic(cpu);
+        return false;
+    }
+
     if (cpu->exception_index >= EXCP_INTERRUPT) {
         /* exit request from the cpu execution loop */
         *ret = cpu->exception_index;
