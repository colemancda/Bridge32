diff --git a/qemu/target/ppc/timebase_helper.c b/qemu/target/ppc/timebase_helper.c
index 8dc0a419..1b43c854 100644
--- a/qemu/target/ppc/timebase_helper.c
+++ b/qemu/target/ppc/timebase_helper.c
@@ -21,17 +21,26 @@
 #include "exec/helper-proto.h"
 #include "exec/exec-all.h"
 
+/* B32_PPC: Unicorn has no virtual clock and never sets up tb_env, so the time
+ * base counts the host's monotonic clock at 25 MHz, a G4 Mac's rate. */
+static uint64_t b32_timebase(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ((uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec) / 40;
+}
+
 /*****************************************************************************/
 /* SPR accesses */
 
 target_ulong helper_load_tbl(CPUPPCState *env)
 {
-    return (target_ulong)cpu_ppc_load_tbl(env);
+    return (target_ulong)b32_timebase();
 }
 
 target_ulong helper_load_tbu(CPUPPCState *env)
 {
-    return cpu_ppc_load_tbu(env);
+    return (target_ulong)(b32_timebase() >> 32);
 }
 
 target_ulong helper_load_atbl(CPUPPCState *env)
