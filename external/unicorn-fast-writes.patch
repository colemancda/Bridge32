+/*
+ * B32_FAST_WRITES: whether a write to mapped memory has to reach a hook. An
+ * unmapped-memory hook can't fire for it, so doesn't need the slow path.
+ */
+static inline bool uc_mem_write_hook_installed(struct uc_struct *uc, hwaddr paddr)
+{
+    return HOOK_EXISTS_BOUNDED(uc, UC_HOOK_MEM_WRITE, paddr) ||
+           HOOK_EXISTS_BOUNDED(uc, UC_HOOK_MEM_WRITE_PROT, paddr);
+}
