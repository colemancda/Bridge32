Unicorn keeps every store on its slow path, which checks for overwritten
code, if the page is executable or if any memory hook is installed. Bridge32
maps all guest memory executable (guests can run code from their heap) and
has an unmapped-memory hook, so every guest write took it. Only pages that
hold translated code need the check, and an unmapped-memory hook can't run
for a mapped page. tb_gen_code puts a page back on the slow path when code
is translated there. Applied by CMakeLists.txt at configure time.

diff --git a/qemu/accel/tcg/cputlb.c b/qemu/accel/tcg/cputlb.c
index 3d0bebd..5f2611e 100644
--- a/qemu/accel/tcg/cputlb.c
+++ b/qemu/accel/tcg/cputlb.c
@@ -1203,14 +1203,19 @@ static void notdirty_write(CPUState *cpu, vaddr mem_vaddr, unsigned size,
         page_collection_unlock(pages);
     }
 
-    /* For exec pages, this is cleared in tb_gen_code. */
+    /*
+     * For pages that hold code, this is cleared in tb_gen_code.
+     * B32_FAST_WRITES: Unicorn tested whether the page is executable, but
+     * Bridge32 maps all guest memory executable (guests can run their heap),
+     * so every write took this path. Only pages with translated code need to.
+     */
     // If we:
     // - have memory hooks installed
     // - or doing snapshot
     // , then never clean the tlb
     if (!(!mr || (tlbe->addr_write != -1 && mr->priority < cpu->uc->snapshot_level)) &&
-            !(tlbe->addr_code != -1) &&
-            !uc_mem_hook_installed(cpu->uc, tlbe->paddr | (mem_vaddr & ~TARGET_PAGE_MASK))) {
+            !tb_page_has_code(cpu->uc, ram_addr) &&
+            !uc_mem_write_hook_installed(cpu->uc, tlbe->paddr | (mem_vaddr & ~TARGET_PAGE_MASK))) {
         tlb_set_dirty(cpu, mem_vaddr);
     }
 }
